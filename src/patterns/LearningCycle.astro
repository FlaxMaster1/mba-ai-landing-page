---
import type { Asset } from "@entities/index";
import { siteUrl } from "@rendering/site-url";
import Heading from "@components/Heading.astro";
import Container from "@utilities/Container.astro";
interface Stage {label:string;description:string}
interface Props { id:string; eyebrow?:string;heading:string;text:string;stages:Stage[];layout?:"split";backgroundImage?:Asset; }
const {id,eyebrow,heading,text,stages,layout,backgroundImage}=Astro.props;
const split = layout === "split";
const backgroundStyle = backgroundImage ? `background-image: url("${siteUrl(backgroundImage.src)}"); background-size: cover; background-position: center; background-repeat: no-repeat;` : undefined;
---
<section id={id} class="p-mba-cycle" style={backgroundStyle} aria-labelledby={id+"-heading"}>
  <Container class={split ? "p-mba-cycle__columns" : undefined}>
    <header class="p-mba-cycle__intro">
      {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
      <Heading as="h2" id={id+"-heading"}>{heading}</Heading>
      <p>{text}</p>
    </header>
    <div class="p-mba-cycle__diagram">
    {split && <p class="p-mba-cycle__return">An ongoing exchange of insight, experience, and questions</p>}
    <ol class="p-mba-cycle__steps">
      {stages.map((stage,index)=>(
        <li class:list={[split && "p-capability-card p-mba-cycle__flip"]}>
          {split ? (
            <button type="button" class="p-capability-card__button" aria-pressed="false" aria-label={`${String(index+1).padStart(2,"0")}, ${stage.label}. ${stage.description} Show or hide details.`}>
              <span class="p-capability-card__inner" aria-hidden="true">
                <span class="p-capability-card__face p-capability-card__front">
                  <span class="p-capability-card__number">{String(index+1).padStart(2,"0")}</span>
                  <span class="p-capability-card__title">{stage.label}</span>
                </span>
                <span class="p-capability-card__face p-capability-card__back">
                  <span class="p-capability-card__number">{String(index+1).padStart(2,"0")}</span>
                  <span class="p-capability-card__title">{stage.label}</span>
                  <span class="p-capability-card__description">{stage.description}</span>
                </span>
              </span>
            </button>
          ) : (
            <>
              <span class="p-mba-cycle__number">{String(index+1).padStart(2,"0")}</span>
              <h3>{stage.label}</h3>
              <p>{stage.description}</p>
            </>
          )}
        </li>
      ))}
    </ol>
    {!split && <p class="p-mba-cycle__return">An ongoing exchange of insight, experience, and questions</p>}
    </div>
  </Container>
</section>
<script>
  import { initializeFlipCards } from "@utilities/flip-cards";
  initializeFlipCards();
</script>
