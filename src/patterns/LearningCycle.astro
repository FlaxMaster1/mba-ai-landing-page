---
import Heading from "@components/Heading.astro";
import Container from "@utilities/Container.astro";
interface Stage {label:string;description:string}
interface Props { id:string; eyebrow?:string;heading:string;text:string;stages:Stage[]; }
const {id,eyebrow,heading,text,stages}=Astro.props;
---
<section id={id} class="p-mba-cycle" aria-labelledby={id+"-heading"}>
  <Container>
    <header class="p-mba-cycle__intro">
      {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
      <Heading as="h2" id={id+"-heading"}>{heading}</Heading>
      <p>{text}</p>
    </header>
    <ol class="p-mba-cycle__steps">
      {stages.map((stage,index)=>(
        <li>
          <span class="p-mba-cycle__number">{String(index+1).padStart(2,"0")}</span>
          <h3>{stage.label}</h3>
          <p>{stage.description}</p>
        </li>
      ))}
    </ol>
    <p class="p-mba-cycle__return">An ongoing exchange of insight, experience, and questions</p>
  </Container>
</section>