---
import Heading from "@components/Heading.astro";
import Stat from "@components/Stat.astro";
import Container from "@utilities/Container.astro";
interface Props { id: string; heading?: string; text?: string; items: Array<{ value: string; label: string; detail?: string }>; }
const { id, heading, text, items } = Astro.props;
---
<section id={id} class="p-section" aria-labelledby={heading ? `${id}-heading` : undefined}>
  <Container>
    {heading && <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>}
    {text && <p class="p-stats-group__intro">{text}</p>}
    <div class="p-stats-group">{items.map((item) => <Stat {...item} />)}</div>
  </Container>
</section>
