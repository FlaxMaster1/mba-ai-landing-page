---
import type { Action, Asset } from "@entities/index";
import Button from "@components/Button.astro";
import Heading from "@components/Heading.astro";
import Image from "@components/Image.astro";
import Container from "@utilities/Container.astro";
import Surface from "@utilities/Surface.astro";
interface Props { id: string; eyebrow?: string; heading: string; text: string; action?: Action; image?: Asset; surface?: "brand-primary" | "brand-accent" | "subtle"; }
const { id, eyebrow, heading, text, action, image, surface = "brand-primary" } = Astro.props;
---
<Surface as="section" tone={surface} class="p-callout" {id} ariaLabelledby={`${id}-heading`}>
  <Container class={image ? "p-callout__layout" : undefined}>
    {image && <Image asset={image} class="p-callout__media" />}
    <div class="p-callout__content">
    {eyebrow && <p class="c-eyebrow">{eyebrow}</p>}
    <Heading as="h2" id={`${id}-heading`}>{heading}</Heading>
    <p>{text}</p>
    {action && <Button href={action.url} variant={surface === "subtle" ? action.type : "secondary"} external={action.external}>{action.label}</Button>}
    </div>
  </Container>
</Surface>
